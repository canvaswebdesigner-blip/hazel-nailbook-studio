# Runtime identity
APP_ENV=local
SITE_URL=http://127.0.0.1:3000

# Supabase server access
# Local values are printed by `bun run db:status` after the local stack starts.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4 booking security
# JSON object keyed by positive integer key version, with high-entropy base64 values.
BOOKING_TOKEN_HMAC_KEYS=
BOOKING_TOKEN_ACTIVE_KEY_VERSION=
RATE_LIMIT_HMAC_SECRET=

# Remote migration/deployment credentials belong in CI environment secrets,
# never in the application runtime environment.
